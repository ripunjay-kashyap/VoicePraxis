{
  "$comment": "What Gemini must return for one clip (v3: verb/object/tool, task.summary, subtasks, Oct 10). The backend's assemble step turns this into episode JSON 0.2 (ids, review fields, pending_questions, clarifications, template_check). All times are decimal seconds from the start of the clip.",
  "type": "object",
  "required": [
    "scene",
    "task",
    "narration",
    "subtasks",
    "actions"
  ],
  "properties": {
    "scene": {
      "type": "string",
      "description": "Short place description, e.g. 'kitchen counter'."
    },
    "task": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "declared_intent",
        "outcome",
        "outcome_evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short task name in plain words."
        },
        "declared_intent": {
          "type": [
            "object",
            "null"
          ],
          "description": "What the person SAID they want to achieve. null if they never said it.",
          "required": [
            "text",
            "utterance_id"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "utterance_id": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "unresolved"
          ]
        },
        "outcome_evidence": {
          "type": "string",
          "description": "What in the video supports the outcome."
        },
        "summary": {
          "type": "string",
          "description": "One plain sentence (max ~20 words) saying what the person did and why, using their stated intent when they gave one."
        }
      }
    },
    "narration": {
      "type": "array",
      "description": "Every spoken utterance, verbatim, in order. Empty if nothing is said or there is no audio.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "text",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "u1, u2, ..."
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "before",
              "during",
              "after",
              "general"
            ],
            "description": "Relative to the action it talks about."
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Physical steps visible in the video, in time order.",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "observed_action",
          "verb",
          "object",
          "tool",
          "instruction",
          "visual_evidence",
          "stated_reason",
          "inferred_reason",
          "why_matters",
          "attempt",
          "outcome",
          "uncertainty"
        ],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "observed_action": {
            "type": "string",
            "description": "Only what the video shows."
          },
          "instruction": {
            "type": "string",
            "description": "Plain imperative command a robot could follow."
          },
          "visual_evidence": {
            "type": "string",
            "description": "What is visible that supports this step."
          },
          "stated_reason": {
            "type": [
              "object",
              "null"
            ],
            "description": "A reason the person SAID for this step. null if none was said.",
            "required": [
              "text",
              "utterance_id"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "utterance_id": {
                "type": "string"
              }
            }
          },
          "inferred_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Your own best guess at why, from what is visible. Never copy a stated reason here. null if you cannot tell."
          },
          "why_matters": {
            "type": "boolean",
            "description": "True if this is a decision point where knowing why would help someone repeat the task."
          },
          "attempt": {
            "type": "string",
            "enum": [
              "first",
              "retry",
              "recovery"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "unresolved"
            ]
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reasons a reviewer should double-check this step."
          },
          "verb": {
            "type": "string",
            "enum": [
              "take",
              "put",
              "hold",
              "lift",
              "lower",
              "place",
              "position",
              "align",
              "press",
              "push",
              "pull",
              "twist",
              "turn",
              "open",
              "close",
              "insert",
              "remove",
              "attach",
              "detach",
              "screw",
              "unscrew",
              "cut",
              "peel",
              "fold",
              "unfold",
              "tape",
              "pour",
              "scoop",
              "mix",
              "stir",
              "wipe",
              "clean",
              "inflate",
              "deflate",
              "flip",
              "shake",
              "tighten",
              "loosen",
              "release",
              "inspect",
              "point",
              "adjust",
              "other"
            ],
            "description": "Main hand action, from this fixed vocabulary so labels are consistent across clips. Use 'other' only if nothing fits."
          },
          "object": {
            "type": "string",
            "description": "Main object acted on: a short lowercase noun phrase without articles, e.g. 'inner tube', 'lid', 'latch'."
          },
          "tool": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tool used, lowercase noun (e.g. 'pump', 'box cutter'). null if only hands."
          }
        }
      }
    },
    "subtasks": {
      "type": "array",
      "description": "The task split into 2-6 sub-goals (phases), in time order. Each groups consecutive actions that serve one purpose.",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "goal",
          "stated_intent",
          "inferred_intent"
        ],
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "goal": {
            "type": "string",
            "description": "Short name of the sub-goal, e.g. 'Seat one side of the tyre'."
          },
          "stated_intent": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "text",
              "utterance_id"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "utterance_id": {
                "type": "string"
              }
            },
            "description": "What the person SAID they were trying to achieve in this phase, with the utterance id. null if not said."
          },
          "inferred_intent": {
            "type": [
              "string",
              "null"
            ],
            "description": "Your own guess at this phase's purpose from the video. Never copy the stated intent. null if unclear."
          }
        }
      }
    }
  }
}
