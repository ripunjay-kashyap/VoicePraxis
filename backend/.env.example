# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.
# Used by local scripts (scripts/probe.py, scripts/run_eval.py).
# The deployed app gets its key from the Modal secret instead:
#   modal secret create gemini GEMINI_API_KEY=<key> --env main

# Gemini API key (free tier while building; paid, capped key for scoring and the demo)
GEMINI_API_KEY=gemini api key
API_BASE=https://ripun-j-kashyap--voicepraxis-api.ap-south.modal.run
